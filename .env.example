# Copy to ".env" (project root, next to app.py). Do not commit .env.

# Canonical public site (use the hostname customers see; Stripe + email image URLs)
# SITE_URL=https://www.licoricelocker.com
# Optional: override base for email images only (defaults to SITE_URL / Railway / www fallback)
# EMAIL_PUBLIC_BASE_URL=https://www.licoricelocker.com

RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Liquorice Locker <orders@your-verified-domain.com>
ADMIN_ORDER_EMAIL=you@example.com

# STRIPE_SECRET_KEY=
# STRIPE_PUBLIC_KEY=
# STRIPE_WEBHOOK_SECRET=
# SECRET_KEY=
# TRUST_PROXY=1

# Shipping prices live in the database (Admin → Shipping pricing).
# CHECKOUT_SHIPPING_CENTS_DEFAULT is ignored and must not be used.
# Store currency is NZD. Checkout does not convert currencies.


# --- Database (required in production) ---
# LICORICE_ENV=development
# Local default is data/licorice-dev.db (or existing data/licorice.db if present).
# DATABASE_PATH=data/licorice.db
#
# Production / Railway (set these on the service; do not commit secrets):
# Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically when a Volume is attached.
# DATABASE_PATH wins if set. If it is empty, the app uses
#   <RAILWAY_VOLUME_MOUNT_PATH>/licorice.db
# If both are missing, production refuses to start. It will not create a blank shop.
# DATABASE_PATH=/data/licorice.db
# DATABASE_VOLUME_ROOT=/data
